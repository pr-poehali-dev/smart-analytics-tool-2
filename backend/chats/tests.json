{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "expectedStatus": 200
    },
    {
      "name": "GET chats without user_id",
      "method": "GET",
      "expectedStatus": 400,
      "expectedBody": {
        "error": "user_id is required"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "GET chats for user",
      "method": "GET",
      "path": "/?user_id=1",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "POST create chat missing fields",
      "method": "POST",
      "body": {
        "user_id": 1
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "user_id and other_user_id are required"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "POST cannot chat with self",
      "method": "POST",
      "body": {
        "user_id": 1,
        "other_user_id": 1
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "Cannot create chat with yourself"
      },
      "bodyMatcher": "partial"
    }
  ]
}
